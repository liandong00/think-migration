{
    "name": "ousaa/think-migration",
    "authors": [
        {
            "name": "liandong",
            "email": "liandong00@qq.com"
        }
    ],
    "license": "Apache-2.0",
    "autoload": {
        "psr-4": {
            "Phinx\\": "phinx",
            "think\\migration\\": "src"
        }
    },
    "require": {
        "php": ">=7.2",
        "topthink/framework": "^6.0 || ^8.0",
        "topthink/think-helper": "^3.0.3"
    },
    "require-dev": {
        "fzaninotto/faker": "^1.8",
        "robmorgan/phinx": "^0.13.4",
        "composer/composer": "^2.5.8"
    },
    "suggest": {
        "fzaninotto/faker": "Required to use the factory builder (^1.8)."
    },
    "scripts": {
        "post-install-cmd": [
            "think\\migration\\UsePhinx::run"
        ],
        "post-update-cmd": [
            "think\\migration\\UsePhinx::run"
        ]
    },
    "extra": {
        "think": {
            "services": [
                "think\\migration\\Service"
            ]
        }
    },
    "dist": {
        "url": "https://gitlab.seastt.com/api/v4/projects/ousaa%2Fphp-packages%2Fthink-migration/repository/archive.zip?sha=%prettyVersion%",
        "type": "zip"
    }
}
